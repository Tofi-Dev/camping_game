pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
#include game.p8

#include draw_code/tree.p8
#include draw_code/rock.p8
#include draw_code/shadow.p8

#include player/player.p8

#include functions/ysort.p8
#include functions/math.p8

#include draw_code/layers.p8
#include items/items.p8
#include object/object.p8

#include functions/misc.p8

current_state = "game"

function _init()
    f = 0
    states = {
        game = { game_draw, game_update }
    }

    game_init()
end

function _draw()
    states[current_state][1]()
end

function _update60()
    states[current_state][2]()
    f += 1
end

