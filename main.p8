#include game.p8
#include draw_code/tree.p8
#include player/player.p8
#include functions/ysort.p8
#include draw_code/layers.p8

current_state = "game"

function _init()
    states = {
        game = {game_draw, game_update}, 
    }
    
    game_init()
end

function _draw()
    states[current_state][1]()
end

function _update60()
    states[current_state][2]()
end

